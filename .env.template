# Per-machine paths for the build/launch scripts.
#
# Copy this file to .env and edit. .env is gitignored, so your paths stay local.
# A real environment variable always wins over a value set here.
#
# Every key is optional: the scripts auto-detect first and only need .env when a tool
# lives somewhere unusual.

# Gale mod manager executable. Used by scripts/launch.ps1 to start the game modded.
# Auto-detected in Program Files and %LOCALAPPDATA%\Programs.
#GALE_PATH=C:\Program Files\gale\gale.exe

# Gale's folder name for the game, as passed to --game. Its data lives in
# %APPDATA%\com.kesomannen.gale\<slug>. Defaults to big-walk.
#GALE_GAME_SLUG=big-walk

# Gale profile to build against and launch. Defaults to Default.
#GALE_PROFILE=Default

# Big Walk install directory. Auto-detected by reading Steam's libraryfolders.vdf.
#BIGWALK_PATH=C:\Program Files (x86)\Steam\steamapps\common\Big Walk

# BepInEx folder to compile against and deploy into. Auto-detected from the Gale or
# r2modman profile, then the game folder. Set this to use a different profile.
#BIGSCREEN_BEPINEX=C:\Users\you\AppData\Roaming\com.kesomannen.gale\big-walk\profiles\Default\BepInEx
